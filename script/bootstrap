#!/usr/bin/env bash
set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$PROJECT_ROOT"

PROJECT_NAME="$(basename "$PROJECT_ROOT")"
export PROJECT_NAME
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$(echo -n "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '_')}"

if [ -f Brewfile ] && [ "$(uname -s)" = "Darwin" ]; then
  if ! brew bundle check >/dev/null 2>&1; then
    echo "==> Installing Homebrew dependencies..."
    brew bundle install --verbose
  fi
fi

if [ ! -f .node-version ]; then
  echo "==> Error: .node-version file not found. Please create .node-version with the required Node version." >&2
  exit 1
fi

if [ -d "$HOME/.nodenv/bin" ] && [[ ":$PATH:" != *":$HOME/.nodenv/bin:"* ]]; then
  export PATH="$HOME/.nodenv/bin:$PATH"
fi

eval "$(nodenv init -)"

if ! nodenv versions --bare | grep -qx "$NODE_VERSION"; then
  echo "==> Node version $NODE_VERSION is not installed. Installing via nodenv..."
  nodenv install --skip-existing "$NODE_VERSION"
fi

if [ -f package.json ]; then
  nodenv local
  echo "==> Installing npm dependencies..."
  npm install
fi
