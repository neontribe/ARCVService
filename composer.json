{
  "name": "neontribe/arcvservice",
  "description": "ARCV Service",
  "version": "1.20.0",
  "keywords": [],
  "license": "proprietary",
  "type": "project",
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/neontribe/laravel-specification.git"
    },
    {
      "type": "git",
      "url": "https://github.com/neontribe/etagconditionals.git"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "barryvdh/laravel-debugbar": "v4.4.4",
    "barryvdh/laravel-dompdf": "v3.1.2",
    "fakerphp/faker": "1.24.1",
    "highsolutions/laravel-searchy": "12.0",
    "imtigger/laravel-job-status": "1.2.0",
    "laravel/framework": "v12.69.3",
    "laravel/helpers": "v1.8.3",
    "laravel/legacy-factories": "v1.4.2",
    "laravel/passport": "v12.4.3",
    "laravel/tinker": "v2.11.1",
    "laravel/ui": "4.6.3",
    "maennchen/zipstream-php": "3.1.2",
    "neontribe/laravel-specification": "dev-master",
    "propaganistas/laravel-phone": "^6.0",
    "ramsey/uuid": "4.9.4",
    "sebdesign/laravel-state-machine": "v3.4.7",
    "spatie/laravel-ciphersweet": "1.7.4",
    "symfony/http-client": "v7.4.20",
    "symfony/lock": "v7.4.20",
    "symfony/mailchimp-mailer": "v7.4.19",
    "usmanhalalit/laracsv": "2.1.0",
    "werk365/etagconditionals": "dev-master"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "v3.7.0",
    "friendsofphp/php-cs-fixer": "v3.95.27",
    "larastan/larastan": "v3.13.0",
    "laravel/browser-kit-testing": "v7.2.8",
    "laravel/dusk": "v8.7.1",
    "mockery/mockery": "1.6.15",
    "nunomaduro/collision": "v8.9.5",
    "phpmd/phpmd": "2.15.0",
    "phpunit/phpunit": "11.5.57",
    "spatie/laravel-ignition": "2.12.0",
    "squizlabs/php_codesniffer": "4.0.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "app/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "php artisan key:generate"
    ],
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "php artisan ide-helper:generate",
      "php artisan ide-helper:meta"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "minimum-stability": "stable",
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  }
}
